# Edge function secrets. Copy to supabase/.env.local (git-ignored), fill in, then run
#   supabase secrets set --env-file supabase/.env.local </dev/null
# Optional settings (defaults in index.ts): CLAUDE_MODEL, CLAUDE_REASONING, CLAUDE_TIMEOUT_MS, REPORT_DAILY_CAP, AI_SPEND_CAP_USD, ALLOWED_ORIGINS
# Same-day alerts (flight-alert/index.ts): ALERT_FROM, ALERT_URGENCY, ALERT_DAILY_CAP, ALERT_APP_URL. Without the two below, alerts are stored but not emailed.
OPENROUTER_API_KEY=
RESEND_API_KEY=
ALERT_TO=
